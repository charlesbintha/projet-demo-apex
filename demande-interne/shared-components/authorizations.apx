authorization administration-rights (
    name: Administration Rights
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody: return true;
    }
    error {
        errorMessage: Insufficient privileges, user is not an Administrator
    }
)

authorization di-acces-application (
    name: DI_ACCES_APPLICATION
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            if sys_context('APEX$SESSION','APP_ID') is null
               or sys_context('APEX$SESSION','APP_ID') <> '100' then
              return false;
            end if;
            return di_security_api.has_role('DEMANDEUR') = 1
                or di_security_api.has_role('AGENT') = 1
                or di_security_api.has_role('RESPONSABLE') = 1;
            ```
    }
    error {
        errorMessage: Acces non autorise ou demande inaccessible.
    }
)

authorization di-affecter-demande (
    name: DI_AFFECTER_DEMANDE
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            declare
              l_id number;
              l_actor number;
              l_role varchar2(20);
              l_count number;
              l_value varchar2(4000);
            begin
              if sys_context('APEX$SESSION','APP_ID') is null
                 or sys_context('APEX$SESSION','APP_ID') <> '100'
                 or apex_application.g_flow_step_id is null
                 or apex_application.g_flow_step_id <> 12 then
                return false;
              end if;
              di_security_api.get_actor(l_actor, l_role);
              l_value := v('P12_DEMANDE_ID');
              if l_value is null or not regexp_like(l_value, '^[0-9]{1,38}$') then
                return false;
              end if;
              l_id := to_number(l_value);
              if l_role <> 'RESPONSABLE' then return false; end if;
              select count(*) into l_count from di_v_demandes
               where id = l_id and statut = 'NOUVELLE';
              return l_count = 1;
            exception
              when no_data_found then return false;
              when others then
                if sqlcode in (-20001,-20002,-20004,-6502,-1722) then
                  return false;
                end if;
                raise;
            end;
            ```
    }
    error {
        errorMessage: Acces non autorise ou demande inaccessible.
    }
)

