page 20 (
    name: Utilisateurs
    alias: UTILISATEURS
    title: Utilisateurs
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region compte-applicatif (
        name: Compte applicatif
        type: staticContent
        source {
            htmlCode: <p>Choisissez un compte puis Charger. Pour créer, choisissez Nouveau compte puis Charger. Le login est défini à la création et reste inchangé lors des modifications. Un nouveau compte est actif ; email et activation se règlent ensuite.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
        }
    )

    region di-utilisateurs (
        name: Utilisateurs
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select id,apex_username,nom_affiche,email,role_code,actif,cree_le from di_utilisateur where di_security_api.has_role('RESPONSABLE')=1 order by nom_affiche,id
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Aucun utilisateur.
        }
        actionsMenu {
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 91001000002000101
        }

        column ACTIF (
            type: plainText
            heading {
                heading: Actif
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column APEX_USERNAME (
            type: plainText
            heading {
                heading: Identifiant
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CREE_LE (
            type: plainText
            heading {
                heading: Création
                alignment: center
            }
            layout {
                sequence: 70
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column EMAIL (
            type: plainText
            heading {
                heading: Email
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ID (
            type: plainText
            heading {
                heading: ID
                alignment: center
            }
