            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P20_USER_ID (
        type: selectList
        label {
            label: Compte à charger
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select nom_affiche||' ('||apex_username||')' d,id r from di_utilisateur where di_security_api.has_role('RESPONSABLE')=1 order by nom_affiche,id
            displayExtraValues: false
            nullDisplayValue: Nouveau compte
        }
        layout {
            sequence: 110
            region: @compte-applicatif
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    button charger (
        buttonName: CHARGER
        label: Charger / Nouveau
        layout {
            sequence: 31
            region: @compte-applicatif
            slot: next
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button creer (
        buttonName: CREER
        label: Créer le compte
        layout {
            sequence: 32
            region: @compte-applicatif
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button enregistrer (
        buttonName: ENREGISTRER
        label: Enregistrer
        layout {
            sequence: 33
            region: @compte-applicatif
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reinitialiser (
        buttonName: REINITIALISER
        label: Réinitialiser le mot de passe
        layout {
            sequence: 34
            region: @compte-applicatif
            slot: next
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process administrer-le-compte (
        name: Administrer le compte
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_id number;
                  procedure charger is
                  begin
                    if l_id is null then
                      :P20_LOGIN:=null; :P20_NOM:=null; :P20_EMAIL:=null;
                      :P20_ROLE:='DEMANDEUR'; :P20_ACTIF:='O'; :P20_TOKEN:=null;
                    else
                      select apex_username,nom_affiche,email,role_code,actif
                      into :P20_LOGIN,:P20_NOM,:P20_EMAIL,:P20_ROLE,:P20_ACTIF
                      from di_utilisateur where id=l_id;
                      :P20_TOKEN:=di_user_admin_api.version_token(l_id);
                    end if;
                  end;
                begin
                  di_security_api.assert_role('RESPONSABLE');
                  l_id:=to_number(:P20_USER_ID default null on conversion error);
                  if :P20_USER_ID is not null and l_id is null then
                    raise_application_error(-20702,'Selection de compte invalide.');
                  end if;
                  case apex_application.g_request
                    when 'CHARGER' then charger;
                    when 'CREER' then
                      if l_id is not null then raise_application_error(-20702,'Selectionner Nouveau compte puis Charger avant de creer.'); end if;
                      di_auth_api.create_user(p_username=>:P20_LOGIN,p_display_name=>:P20_NOM,
                        p_role=>:P20_ROLE,p_password=>:P20_PASSWORD,p_user_id=>l_id);
                      :P20_USER_ID:=to_char(l_id,'TM9');
                      charger;
                      apex_application.g_print_success_message:='Compte actif cree. Vous pouvez maintenant renseigner son email.';
                    when 'ENREGISTRER' then
                      if l_id is null then raise_application_error(-20702,'Charger un compte existant.'); end if;
                      di_user_admin_api.save_user(l_id,:P20_NOM,:P20_EMAIL,:P20_ROLE,:P20_ACTIF,:P20_TOKEN);
                      charger;
                      apex_application.g_print_success_message:='Compte mis a jour.';
                    when 'REINITIALISER' then
                      if l_id is null then raise_application_error(-20702,'Charger un compte existant.'); end if;
                      if :P20_TOKEN is null or :P20_TOKEN<>di_user_admin_api.version_token(l_id) then
                        raise_application_error(-20701,'Rechargez le compte avant de reinitialiser son mot de passe.');
                      end if;
                      di_auth_api.reset_password(p_user_id=>l_id,p_new_password=>:P20_PASSWORD);
                      apex_application.g_print_success_message:='Mot de passe reinitialise.';
                    else raise_application_error(-20003,'Action non autorisee.');
                  end case;
                  :P20_PASSWORD:=null;
                exception when others then
                  :P20_PASSWORD:=null;
                  if sqlcode between -20704 and -20701 then
                    apex_error.add_error(p_message=>substr(sqlerrm,12),p_display_location=>apex_error.c_inline_in_notification);
                  elsif sqlcode=-1 then
                    apex_error.add_error(p_message=>'Cet identifiant existe deja.',p_display_location=>apex_error.c_inline_in_notification);
                  elsif sqlcode in (-20204,-20201) then
                    apex_error.add_error(p_message=>'Verifier le nom, le role et le login. Le mot de passe doit contenir de 15 a 100 caracteres.',p_display_location=>apex_error.c_inline_in_notification);
                  else raise;
                  end if;
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 91001000002000202
        }
    )

    process vérifier-le-responsable (
        name: Vérifier le responsable
        type: executeCode
        source {
            plsqlCode: begin di_security_api.assert_role('RESPONSABLE'); :P20_PASSWORD:=null; end;
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 91001000002000201
        }
    )

    branch (
        name: Afficher le compte après succès
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 20
            }
        }
    )

)

