        savedReport DI_USERS_20 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIF (
                sequence: 6
            )

            displayColumn APEX_USERNAME (
                sequence: 2
            )

            displayColumn CREE_LE (
                sequence: 7
            )

            displayColumn EMAIL (
                sequence: 4
