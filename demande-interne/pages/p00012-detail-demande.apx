            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Aucune donnée accessible pour ces critères.
            whenMoreDataFound: Limite du rapport atteinte. Affinez les filtres.
        }
