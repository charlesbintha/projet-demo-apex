page 12 (
    name: Détail de la demande
    alias: DETAIL-DEMANDE
    title: Détail de la demande
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
        cssClasses: di-page
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @di-lire-demande
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region di-1 (
        name: Informations
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  l_id number;
                  procedure field(p_label varchar2, p_value varchar2) is
                  begin
                    htp.p('<dt>' || apex_escape.html(p_label) || '</dt><dd>' ||
                          apex_escape.html(nvl(p_value, 'Non renseigné')) || '</dd>');
                  end;
                begin
                  if :P12_DEMANDE_ID is null or not regexp_like(:P12_DEMANDE_ID, '^[0-9]{1,38}$') then
                    raise_application_error(-20004, 'Demande inexistante ou inaccessible.');
                  end if;
                  l_id := to_number(:P12_DEMANDE_ID);
                  di_security_api.assert_request_access(l_id);
                  for r in (
                    select d.*, c.libelle as categorie, u.nom_affiche as demandeur,
                           a.nom_affiche as agent
                      from di_v_demandes d
                      join di_categorie c on c.id = d.categorie_id
                      join di_utilisateur u on u.id = d.demandeur_id
                      left join di_utilisateur a on a.id = d.agent_id
                     where d.id = l_id
                  ) loop
                    htp.p('<div class="di-page di-panel"><p class="di-eyebrow">Demande ' ||
                          apex_escape.html(to_char(r.id,'TM9')) || '</p>');
                    htp.p('<h2 class="di-section-title">' || apex_escape.html(r.objet) || '</h2>');
                    htp.p('<p><span class="di-status di-status--' ||
                      case r.statut when 'NOUVELLE' then 'nouvelle' when 'AFFECTEE' then 'affectee'
                        when 'EN_COURS' then 'en-cours' when 'RESOLUE' then 'resolue'
                        when 'CLOTUREE' then 'cloturee' end || '">' ||
                      case r.statut when 'NOUVELLE' then 'Nouvelle' when 'AFFECTEE' then 'Affectée'
                        when 'EN_COURS' then 'En cours' when 'RESOLUE' then 'Résolue'
                        when 'CLOTUREE' then 'Clôturée' end || '</span></p>');
                    htp.p('<dl class="di-facts">');
                    field('Catégorie', r.categorie);
                    field('Priorité', case r.priorite when 'BASSE' then 'Basse' when 'NORMALE' then 'Normale'
                           when 'HAUTE' then 'Haute' when 'URGENTE' then 'Urgente' end);
                    field('Demandeur', r.demandeur);
                    field('Agent', nvl(r.agent, 'Non affecté'));
                    field('Créée le', to_char(r.cree_le, 'DD/MM/YYYY HH24:MI TZH:TZM'));
                    field('Affectée le', to_char(r.affecte_le, 'DD/MM/YYYY HH24:MI TZH:TZM'));
                    field('Démarrée le', to_char(r.demarre_le, 'DD/MM/YYYY HH24:MI TZH:TZM'));
                    field('Résolue le', to_char(r.resolu_le, 'DD/MM/YYYY HH24:MI TZH:TZM'));
                    field('Clôturée le', to_char(r.cloture_le, 'DD/MM/YYYY HH24:MI TZH:TZM'));
                    htp.p('</dl><h3 class="di-section-title">Description</h3><p class="di-prose">' ||
                      apex_escape.html(r.description) || '</p>');
                    if r.resolution is not null then
                      htp.p('<h3 class="di-section-title">Explication de résolution</h3><p class="di-prose">' ||
                        apex_escape.html(r.resolution) || '</p>');
                    end if;
                    htp.p('</div>');
                  end loop;
                end;
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: di-region
        }
    )

