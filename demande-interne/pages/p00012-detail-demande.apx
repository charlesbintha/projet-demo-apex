    process contrôler-accès-et-charger-version (
        name: Contrôler accès et charger version
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_id number;
                  l_actor number;
                  l_role varchar2(20);
                begin
                  di_security_api.get_actor(l_actor, l_role);
                  if :P12_DEMANDE_ID is null or not regexp_like(:P12_DEMANDE_ID, '^[0-9]{1,38}$') then
                    raise_application_error(-20004, 'Demande inexistante ou inaccessible.');
                  end if;
                  l_id := to_number(:P12_DEMANDE_ID);
                  di_security_api.assert_request_access(l_id);
                  -- Ne pas rafraichir la version apres un POST en erreur : cela masquerait
                  -- un conflit de concurrence. Le lien Recharger produit un nouveau GET.
                  if apex_application.g_request is null then
                    select version_no into :P12_VERSION_NO from di_v_demandes where id = l_id;
                    :P12_AGENT_ID := null;
                    :P12_RESOLUTION := null;
                    :P12_COMMENTAIRE := null;
                  end if;
                exception
                  when no_data_found then
                    raise_application_error(-20004, 'Demande inexistante ou inaccessible.');
                end;
                
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 91001000001012300
        }
    )

    process exécuter-action-métier (
        name: Exécuter action métier
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_id number;
                  l_version number;
                  l_agent number;
                  l_message varchar2(4000);
                  l_success varchar2(200);
                begin
                  if :P12_DEMANDE_ID is null or not regexp_like(:P12_DEMANDE_ID, '^[0-9]{1,38}$') then
                    raise_application_error(-20004, 'Demande inexistante ou inaccessible.');
                  end if;
                  l_id := to_number(:P12_DEMANDE_ID);
                  -- Controle serveur independant de tout bouton ou autorisation mise en cache.
                  di_security_api.assert_request_access(l_id);
                  if :P12_VERSION_NO is null or not regexp_like(:P12_VERSION_NO, '^[0-9]{1,38}$') then
                    raise_application_error(-20007, 'Version absente ou invalide. Recharger la demande.');
                  end if;
                  l_version := to_number(:P12_VERSION_NO);
                  case apex_application.g_request
                    when 'AFFECTER' then
                      di_security_api.assert_role('RESPONSABLE');
                      if :P12_AGENT_ID is null or not regexp_like(:P12_AGENT_ID, '^[0-9]{1,38}$') then
                        raise_application_error(-20008, 'Sélectionnez un agent actif.');
                      end if;
                      l_agent := to_number(:P12_AGENT_ID);
                      di_request_api.affecter_agent(p_demande_id => l_id, p_agent_id => l_agent,
                                                   p_version_attendue => l_version);
                      l_success := 'La demande a été affectée.';
                    when 'DEMARRER' then
                      di_security_api.assert_role('AGENT');
                      di_request_api.demarrer_traitement(p_demande_id => l_id, p_version_attendue => l_version);
                      l_success := 'Le traitement a démarré.';
                    when 'RESOUDRE' then
                      di_security_api.assert_role('AGENT');
                      di_request_api.resoudre_demande(p_demande_id => l_id, p_resolution => :P12_RESOLUTION,
                                                     p_version_attendue => l_version);
                      l_success := 'La demande a été résolue.';
                    when 'CLOTURER' then
                      di_request_api.cloturer_demande(p_demande_id => l_id, p_version_attendue => l_version);
                      l_success := 'La demande a été clôturée.';
                    when 'COMMENTER' then
                      di_request_api.commenter_demande(p_demande_id => l_id, p_contenu => :P12_COMMENTAIRE,
                                                      p_version_attendue => l_version);
                      l_success := 'Le commentaire a été ajouté.';
                    else
                      raise_application_error(-20003, 'Action non autorisée.');
                  end case;
                  -- Pas de COMMIT : APEX valide la transaction apres traitement reussi.
                  apex_application.g_print_success_message := l_success;
                exception
                  when others then
                    l_message := case sqlcode
                      when -20001 then 'Votre session a expiré. Reconnectez-vous.'
                      when -20002 then 'Votre compte est absent ou inactif.'
                      when -20003 then 'Vous ne pouvez pas effectuer cette action.'
                      when -20004 then 'Demande inexistante ou inaccessible.'
                      when -20005 then 'Cette action est impossible dans l’état actuel de la demande.'
                      when -20006 then 'Saisissez un texte non vide, limité à 4 000 octets.'
                      when -20007 then 'La demande a changé depuis son affichage. Copiez votre texte puis utilisez Recharger avant de recommencer.'
                      when -20008 then 'Sélectionnez un agent actif.'
                      else null end;
                    if l_message is null then raise; end if;
                    apex_error.add_error(p_message => l_message,
                                        p_display_location => apex_error.c_inline_in_notification);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 91001000001012301
        }
    )

    branch (
        name: Recharger après action réussie
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 12
                items: {
                    P12_DEMANDE_ID: &P12_DEMANDE_ID.
                }
                clearCache: 12
            }
        }
    )

)

