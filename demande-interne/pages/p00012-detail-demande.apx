    region di-commentaires (
        name: Commentaires
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.cree_le, u.nom_affiche as auteur, c.contenu
                from di_v_commentaires c join di_utilisateur u on u.id=c.auteur_id
                where c.demande_id=to_number(:P12_DEMANDE_ID)
                order by c.cree_le desc, c.id desc
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: di-report
        }
