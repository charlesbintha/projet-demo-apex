    region di-historique (
        name: Historique des actions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.cree_le, u.nom_affiche as acteur, h.action_code as action,
                 h.ancien_statut, h.nouveau_statut, a.nom_affiche as agent_avant,
                 n.nom_affiche as agent_apres, h.detail
                from di_v_historique h join di_utilisateur u on u.id=h.acteur_id
                left join di_utilisateur a on a.id=h.ancien_agent_id
                left join di_utilisateur n on n.id=h.nouvel_agent_id
                where h.demande_id=to_number(:P12_DEMANDE_ID)
                order by h.cree_le desc, h.id desc
                ```
        }
